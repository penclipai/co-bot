{
  "openmausbot": {
    "url": "http://127.0.0.1:8799",
    "timeoutMs": 15000,
    "token": "",
    "autoStart": true,
    "cliComputerOff": true,
    "syncChiefIdentity": true
  },
  "transport": "sim",
  "channel": {
    "use": "",
    "options": {}
  },
  "ipc": {
    "client": "./ipc-client.js",
    "selfId": "<你在 IM 中的用户 id>",
    "selfChatId": "",
    "atAllCountsAsMention": false
  },
  "web": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "selfChat": {
    "trigger": "@bot",
    "commandDevices": [],
    "proactive": true,
    "quietHours": {
      "enabled": false,
      "start": "22:00",
      "end": "08:30"
    },
    "markdown": true,
    "resultChars": 1500,
    "softSplitChars": 2800,
    "followUpWindowMs": 120000,
    "hideChiefPrefix": true,
    "imageBatchMs": 1500,
    "fileRetentionDays": 7,
