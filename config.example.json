  "chats": {
    "mode": "owner_everywhere",
    "enabledTypes": ["self", "group", "direct"],
    "allowChatIds": [],
    "denyChatIds": [],
    "triggerAliases": [],
    "contextWindow": 15,
    "contextMaxMessagesPerChat": 120,
    "contextTtlMs": 86400000,
