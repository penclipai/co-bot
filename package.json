{
  "name": "co-bot",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "description": "co-bot：跨平台 IM 手机自聊 ↔ OpenMausBot 桥接网关",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "sim": "node src/index.ts --channel sim",
    "daemon": "node scripts/daemon.ts",
    "restart": "node scripts/daemon.ts restart",
    "stop": "node scripts/daemon.ts stop",
    "status": "node scripts/daemon.ts status",
    "omb": "node scripts/omb.ts",
    "pair": "node scripts/pair.ts",
    "check": "node scripts/check.ts",
    "channel:test": "node scripts/channel-test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run typecheck && npm run lint && npm test && npm run channel:test -- --dry",
    "test": "node --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^24.19.2",
    "eslint": "10.9.1",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
